<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <PackageId>Indtec.ExcelMapper</PackageId>
    <Version>1.1.0</Version>
    <Title>Indtec.ExcelMapper</Title>
    <Authors>fogacafe</Authors>
    <Company>Indtec</Company>
    <Description>Source-generated Excel mapper for .NET with typed import/export, validation, multi-sheet workbooks, localized messages and memory-bounded streaming chunk imports.</Description>
    <PackageTags>excel;xlsx;mapper;source-generator;roslyn;attributes;closedxml;openxml;streaming;chunks;localization;pt-br;styling;validation;batch;workbook;multi-sheet;template;converter;nuget</PackageTags>
    <PackageProjectUrl>https://github.com/fogacafe/indtec-labz-excel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fogacafe/indtec-labz-excel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Adds English and pt-BR processing messages with custom overrides, reusable Excel format masks, and a forward-only Open XML chunk import path for large worksheets without materializing the full worksheet in ClosedXML.</PackageReleaseNotes>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Indtec.ExcelMapper.Generators/Indtec.ExcelMapper.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../Indtec.ExcelMapper.Generators/bin/$(Configuration)/netstandard2.0/Indtec.ExcelMapper.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>
</Project>
