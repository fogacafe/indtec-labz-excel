<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <PackageId>Indtec.ExcelMapper</PackageId>
    <Version>1.0.1</Version>
    <Title>Indtec.ExcelMapper</Title>
    <Authors>fogacafe</Authors>
    <Company>Indtec</Company>
    <Description>Source-generated Excel mapper for .NET with strongly typed import/export, reusable themes, custom converters, required columns and row-aware conditional styling.</Description>
    <PackageTags>excel;xlsx;mapper;source-generator;roslyn;attributes;closedxml;styling;converter;nuget</PackageTags>
    <PackageProjectUrl>https://github.com/fogacafe/indtec-labz-excel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fogacafe/indtec-labz-excel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Documentation and package metadata polish. Release version is derived from the Git tag by the publishing workflow.</PackageReleaseNotes>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Indtec.ExcelMapper.Generators/Indtec.ExcelMapper.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../Indtec.ExcelMapper.Generators/bin/$(Configuration)/netstandard2.0/Indtec.ExcelMapper.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>
</Project>
